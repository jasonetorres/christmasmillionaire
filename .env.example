# Server-only. Neon gives you this connection string. It also works with any
# standard Postgres URL. Never prefix it with VITE_. It is not sent to the browser.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE

# Shared secret checked by /api/host. The host page sends it in a header.
# Anyone who knows it can run the show, so keep it off stream and out of chat.
HOST_CODE=choose-a-long-random-code

# Optional. Phone a Friend and /santa return a clear error when either is empty.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
