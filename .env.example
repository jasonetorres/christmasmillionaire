# Public client config. Vite inlines these into the browser bundle at build time.
# Set the same names on the Vercel project for Production, Preview, and Development,
# then redeploy. Anyone can see these values in the built JavaScript.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Used by `npm run seed`. Never prefix this with VITE_ and do not
# add it to the Vercel project. The service role bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Phone a Friend does not read this file. Set these as Supabase Edge Function
# secrets, not as Vercel env vars:
#   OPENAI_API_KEY
#   ELEVENLABS_API_KEY
